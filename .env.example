# ==============================================================================
# FinanceAI — Environment Configuration Specification (v1.0 Production)
# ==============================================================================
# Copy this file to .env.local (development) or configure via your production host
# (Vercel, Railway, Render, Docker, AWS ECS). Never commit actual secret values.
# All secret keys must remain server-side only; only NEXT_PUBLIC_* are in client bundles.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & ENVIRONMENT SPECIFICATION
# ------------------------------------------------------------------------------
# Canonical URL of the application. Required in staging/production for redirects, OAuth, and CORS.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Runtime Environment Conventions:
# - Next.js strictly expects NODE_ENV to be "development", "test", or "production".
# - In both staging and production hostings, keep NODE_ENV="production" for Next.js optimizations.
# - Use APP_ENV to specify the deployment tier: "development", "staging", or "production".
NODE_ENV="production"
APP_ENV="staging"

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL & Prisma ORM)
# ------------------------------------------------------------------------------
# PostgreSQL database connection string.
# In production, use transaction connection pooling (e.g., Supabase / Neon / PgBouncer).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/financeai?schema=public"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (Clerk Identity Provider)
# ------------------------------------------------------------------------------
# In development, the system falls back to a seeded demo user if keys are absent.
# In staging/production, both Clerk keys are strictly required.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_placeholder_key"
CLERK_SECRET_KEY="sk_test_placeholder_key"

# Clerk redirect routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ------------------------------------------------------------------------------
# 4. ARTIFICIAL INTELLIGENCE PROVIDERS
# ------------------------------------------------------------------------------
# Primary Provider: NVIDIA NIM (OpenAI-compatible inference endpoint)
AI_PRIMARY_PROVIDER="nvidia"
NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_NIM_API_KEY=""
NVIDIA_NIM_ADVISOR_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning"
NVIDIA_NIM_IMPORT_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning"
NVIDIA_NIM_TIMEOUT_MS=45000
NVIDIA_NIM_IMPORT_TIMEOUT_MS=90000

# Secondary Fallback Provider: Google Gemini (optional failover or consent-based)
AI_FALLBACK_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
AI_TIMEOUT_MS=20000

# ------------------------------------------------------------------------------
# 5. PERSISTENT CACHE & RATE LIMITING (Upstash Redis REST)
# ------------------------------------------------------------------------------
# Optional in development (defaults to in-memory Map). Recommended in serverless production
# to share market quote caches, rate limit tokens, and circuit breaker states across instances.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ------------------------------------------------------------------------------
# 6. SCHEDULED JOBS & CRON (Vercel Cron / QStash)
# ------------------------------------------------------------------------------
# Secret token required to trigger /api/cron/prices. Enforced in production via
# Authorization: Bearer <CRON_SECRET>.
CRON_SECRET="generate_a_secure_random_hex_token_for_cron"

# ------------------------------------------------------------------------------
# 7. MARKET DATA & FOREIGN EXCHANGE APIS
# ------------------------------------------------------------------------------
# Indian Stocks: yahoo-finance2 (BSE/NSE EOD quotes; unofficial, server-side only)
# Mutual Fund NAVs: https://api.mfapi.in (AMFI NAV data; free public API)
# USD→INR Exchange Rates: https://api.frankfurter.dev/v1 (ECB published rates)
MFAPI_BASE_URL="https://api.mfapi.in"
FX_API_BASE_URL="https://api.frankfurter.dev/v1"
PROVIDER_TIMEOUT_MS=8000
ENRICH_TIMEOUT_MS=25000
STOCK_PRICE_TTL_SECONDS=300
MF_NAV_TTL_SECONDS=21600

# ------------------------------------------------------------------------------
# 8. LEGACY / DUAL-MODE FIREBASE (Optional Rollback Path)
# ------------------------------------------------------------------------------
# Set USE_FIREBASE=true only if routing through Firestore instead of PostgreSQL.
USE_FIREBASE=false
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""
