// FinanceAI — Prisma schema (PostgreSQL)
// Enums are stored as strings with TS-level enums enforcing values.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  clerkId     String?  @unique
  email       String   @unique
  name        String?
  currency    String   @default("INR")
  privacyMode Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets            Asset[]
  transactions      Transaction[]
  liabilities       Liability[]
  goals             Goal[]
  budgets           Budget[]
  snapshots         Snapshot[]
  allocationTargets AllocationTarget[]
  conversations     AIConversation[]
  accounts          Account[]

  @@index([email])
}

// type: BANK | BROKER | CREDIT_CARD | WALLET | OTHER
// Represents a named financial account owned by a user.
// Transaction.account (String?) and Asset.account (String?) remain for backward compat.
// New records should link via accountId instead; old flat-string records are kept as-is.
model Account {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String    // e.g. "HDFC Savings", "Zerodha Demat"
  type        String    @default("OTHER") // BANK | BROKER | CREDIT_CARD | WALLET | OTHER
  currency    String    @default("INR")
  isDefault   Boolean   @default(false)
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  closedAt    DateTime? // soft-close: account closed but history preserved

  transactions  Transaction[]
  assets        Asset[]

  @@unique([userId, name]) // each user's account names must be unique
  @@index([userId, closedAt])
}

// type: STOCK | MUTUAL_FUND | CRYPTO | REAL_ESTATE | CASH
model Asset {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String
  name          String
  symbol        String?
  quantity      Decimal   @db.Decimal(18, 6)
  avgBuyPrice   Decimal   @db.Decimal(19, 4)
  currentPrice  Decimal   @db.Decimal(19, 4)
  currency      String    @default("INR")
  account       String?
  importSource  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // ── Portfolio import (broker snapshot) fields ────────────────────────────
  isin           String?   // stable identifier (stocks + mutual funds) when the export has one
  exchange       String?   // NSE | BSE | US — resolved from the symbol/ISIN
  folio          String?   // mutual-fund folio number (identity component, not displayed as PII)
  importKey      String?   // "<broker>|<assetClass>|<account>|<identity>" — idempotent re-import key
  priceSource    String?   // YAHOO | MFAPI | STATEMENT | COST_BASIS (COST_BASIS = no price yet)
  priceUpdatedAt DateTime?

  // ── Account FK (optional — populated when linked to an Account entity) ──
  accountId      String?
  accountRef     Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([userId, importKey])
  @@index([userId, type])
  @@index([userId, deletedAt])
  @@index([userId, accountId])
}

// type: INCOME | EXPENSE | TRANSFER
model Transaction {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  amount      Decimal   @db.Decimal(19, 4)
  category    String
  description String?
  date        DateTime
  account     String?   // flat string for backward compat / import-sourced records
  tags        String    @default("[]") // JSON string array
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  // ── Account FK (optional — populated when linked to an Account entity) ──
  accountId   String?
  accountRef  Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)

  // ── Transfer identity (LEDGER-004) ──
  transferGroupId String?

  @@index([userId, date, deletedAt])
  @@index([userId, category, deletedAt])
  @@index([userId, accountId])
}

// type: HOME_LOAN | CAR_LOAN | PERSONAL_LOAN | CREDIT_CARD | OTHER
model Liability {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  name              String
  principalAmount   Decimal   @db.Decimal(19, 4)
  outstandingAmount Decimal   @db.Decimal(19, 4)
  interestRate      Float     // Keep interestRate as Float since it's a percentage, or make it Decimal? The plan didn't mention interestRate. Let's keep Float.
  monthlyEMI        Decimal?  @db.Decimal(19, 4)
  dueDate           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
}

// status: ACTIVE | COMPLETED | PAUSED
model Goal {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  targetAmount    Decimal  @db.Decimal(19, 4)
  currentAmount   Decimal  @db.Decimal(19, 4) @default(0)
  targetDate      DateTime
  monthlyRequired Decimal  @db.Decimal(19, 4) @default(0)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, status])
}

model Budget {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     String
  monthlyLimit Decimal  @db.Decimal(19, 4)
  month        Int
  year         Int
  alertAt80    Boolean  @default(true)
  alertAt100   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, category, month, year])
  @@index([userId, year, month])
}

model Snapshot {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime
  totalAssets      Decimal  @db.Decimal(19, 4)
  totalLiabilities Decimal  @db.Decimal(19, 4)
  netWorth         Decimal  @db.Decimal(19, 4)
  breakdown        String   @default("{}") // JSON string
  createdAt        DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

// assetType: STOCK | MUTUAL_FUND | CRYPTO | REAL_ESTATE | CASH
model AllocationTarget {
  id            String @id @default(cuid())
  userId        String
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetType     String
  targetPercent Float

  @@unique([userId, assetType])
}

// action: PORTFOLIO_ANALYSIS | SUGGEST_INVESTMENTS | REBALANCING_ADVICE | CUSTOM_CHAT | ...
model AIConversation {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action          String
  messages        String   @default("[]") // JSON string of messages
  contextSnapshot String   @default("{}") // JSON string
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}
